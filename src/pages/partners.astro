---
import {
  RiBookOpenLine,
  RiGraduationCapLine,
  RiHandHeartLine,
  RiLeafLine,
} from '@remixicon/react';
import PageHero from '@/components/layout/page-hero.astro';
import SiteFooter from '@/components/layout/site-footer.astro';
import SiteHeader from '@/components/layout/site-header.astro';
import { buttonVariants } from '@/components/ui/button';
import Layout from '@/layouts/main.astro';
import { accentSoftBg, accentText } from '@/lib/accent';
import { programIcons } from '@/lib/program-icons';
import { programDetails, site, stats } from '@/lib/site-data';
import { cn } from '@/lib/utils';

const icons = {
  RiGraduationCapLine,
  RiBookOpenLine,
  RiHandHeartLine,
  RiLeafLine,
} as const;
---

<Layout title={`Partners | ${site.name}`} description={site.positioning}>
  <SiteHeader />
  <main>
    <PageHero
      eyebrow="Partners"
      title="Een hub-and-spoke model, gebouwd op samenwerking"
      description="Stichting Probitas is de centrale organisatie: we ontwikkelen, verbinden en ondersteunen. De uitvoering verloopt via gespecialiseerde programma's en partners."
    />

    <section class="bg-accent/70 py-16">
      <div class="mx-auto max-w-7xl px-6">
        <div class="grid grid-cols-2 gap-8 sm:grid-cols-4">
          {stats.map((stat) => {
              const Icon = icons[stat.icon as keyof typeof icons];
              return (
                <div class="flex flex-col items-center gap-3 text-center">
                  <div class={cn('flex size-14 items-center justify-center rounded-2xl', accentSoftBg[stat.accent])}>
                    <Icon className={cn('size-7', accentText[stat.accent])} />
                  </div>
                  <div class="font-heading text-4xl font-bold text-foreground">{stat.value}</div>
                  <div class="text-sm text-muted-foreground">{stat.label}</div>
                </div>
              );
            })}
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-6 py-20">
      <div class="mb-12 text-center">
        <h2
          class="font-heading text-3xl font-bold tracking-tight text-foreground sm:text-4xl"
        >
          Onze programma&rsquo;s &amp; partners
        </h2>
        <p class="mx-auto mt-3 max-w-2xl text-muted-foreground">
          Elk programma is een gespecialiseerde partner binnen het netwerk van
          Probitas.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {programDetails.map((program) => {
            const Icon = programIcons[program.icon];
            return (
              <a
                href={`/programs/${program.slug}`}
                class="group flex items-start gap-4 rounded-xl border border-border p-5 transition-colors hover:border-foreground/20 hover:bg-muted"
              >
                <span class={cn('flex size-11 shrink-0 items-center justify-center rounded-full', accentSoftBg[program.accent])}>
                  <Icon className={cn('size-5', accentText[program.accent])} />
                </span>
                <span>
                  <span class="block font-heading text-sm font-semibold text-foreground">{program.title}</span>
                  <span class="mt-1 block text-sm text-muted-foreground">{program.summary}</span>
                </span>
              </a>
            );
          })}
      </div>
    </section>

    <section class="bg-navy py-20">
      <div class="mx-auto max-w-2xl px-6 text-center">
        <h2 class="font-heading text-2xl font-bold text-white sm:text-3xl">
          Word partner van Probitas
        </h2>
        <p class="mx-auto mt-3 max-w-xl text-white/70">
          Wil je samen met ons impact maken op het gebied van onderwijs,
          technologie of landbouw? We horen graag van je.
        </p>
        <div class="mt-8">
          <a
            href="/contact"
            class={cn(buttonVariants({ size: 'lg' }), 'gap-1.5 rounded-full px-8')}
          >
            Word Partner
            <RiHandHeartLine />
          </a>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</Layout>
