---
import { accentText } from '@/lib/accent';
import { pillars, site } from '@/lib/site-data';

interface Props {
  variant?: 'light' | 'dark';
  class?: string;
}

const { variant = 'light', class: className = '' } = Astro.props;

const textColor = variant === 'light' ? 'text-white' : 'text-foreground';
const bulletColor =
  variant === 'light' ? 'text-white/40' : 'text-muted-foreground/60';
---

<a href="#home" class={`flex items-center gap-3 ${className}`}>
  <img
    src="/brand/icon.png"
    alt={site.name}
    class="size-10 shrink-0"
    width="40"
    height="40"
  >
  <span class="flex flex-col leading-tight">
    <span
      class={`font-heading text-lg font-semibold tracking-wide ${textColor}`}
    >
      {site.name}
    </span>
    <span
      class="flex flex-wrap items-center gap-x-1 text-[11px] font-medium tracking-tight"
    >
      {pillars.map((pillar, index) => (
          <>
            {index > 0 && <span class={bulletColor}>&bull;</span>}
            <span class={accentText[pillar.accent]}>{pillar.label}</span>
          </>
        ))}
    </span>
  </span>
</a>
