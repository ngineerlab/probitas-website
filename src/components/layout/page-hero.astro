---
import { type Accent, accentSoftBg, accentText } from '@/lib/accent';
import { cn } from '@/lib/utils';

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  accent?: Accent;
}

const { eyebrow, title, description, accent } = Astro.props;
---

<section class="relative isolate overflow-hidden bg-navy py-20 sm:py-24">
  <div
    class="absolute inset-0 bg-[radial-gradient(circle_at_15%_20%,rgba(255,255,255,0.06),transparent_55%)]"
  ></div>
  <div class="relative mx-auto max-w-4xl px-6 text-center">
    {eyebrow && (
        <p
          class={cn(
            'mb-4 inline-flex items-center gap-2 rounded-full px-3 py-1 text-xs font-semibold tracking-wide uppercase',
            accent ? accentSoftBg[accent] : 'bg-white/10',
            accent ? accentText[accent] : 'text-white/80',
          )}
        >
          {eyebrow}
        </p>
      )}
    <h1 class="font-heading text-4xl font-bold text-white sm:text-5xl">
      {title}
    </h1>
    {description && (
        <p class="mx-auto mt-5 max-w-2xl text-base text-white/70 sm:text-lg">
          {description}
        </p>
      )}
    <slot />
  </div>
</section>
