---
import {
  RiFacebookFill,
  RiGlobalLine,
  RiInstagramLine,
  RiLinkedinFill,
  RiMailLine,
  RiMapPin2Line,
  RiPhoneLine,
  RiYoutubeFill,
} from '@remixicon/react';
import LogoMark from '@/components/logo-mark.astro';
import { Separator } from '@/components/ui/separator';
import { contact, footerLinks, site, socials } from '@/lib/site-data';

const socialIcons = {
  RiFacebookFill,
  RiInstagramLine,
  RiLinkedinFill,
  RiYoutubeFill,
} as const;
---

<footer id="contact" class="bg-navy text-navy-foreground">
  <div class="mx-auto max-w-7xl px-6 py-16">
    <div class="grid grid-cols-1 gap-12 md:grid-cols-[1.4fr_1fr_1fr_1.2fr]">
      <div>
        <LogoMark variant="light" />
        <p class="mt-5 max-w-xs text-sm text-white/65">
          Wij geloven in de kracht van technologie, onderwijs en samenwerking om
          mensen en gemeenschappen te ontwikkelen en een duurzame toekomst te
          bouwen.
        </p>
        <p class="mt-4 font-heading text-sm text-white/80 italic">
          Jezelf ontwikkelen, elkaar verrijken.
        </p>
      </div>

      <div>
        <h3
          class="font-heading text-sm font-semibold tracking-wide text-white uppercase"
        >
          Snel naar
        </h3>
        <ul class="mt-4 space-y-2.5">
          {footerLinks.map((link) => (
              <li>
                <a href={link.href} class="text-sm text-white/65 transition-colors hover:text-white">
                  {link.label}
                </a>
              </li>
            ))}
        </ul>
      </div>

      <div>
        <h3
          class="font-heading text-sm font-semibold tracking-wide text-white uppercase"
        >
          Volg ons
        </h3>
        <div class="mt-4 flex gap-3">
          {socials.map((social) => {
              const Icon = socialIcons[social.icon as keyof typeof socialIcons];
              return (
                <a
                  href={social.href}
                  aria-label={social.label}
                  class="flex size-9 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-primary"
                >
                  <Icon className="size-4" />
                </a>
              );
            })}
        </div>
      </div>

      <div>
        <h3
          class="font-heading text-sm font-semibold tracking-wide text-white uppercase"
        >
          Contact
        </h3>
        <ul class="mt-4 space-y-3 text-sm text-white/65">
          <li class="flex items-start gap-2.5">
            <RiMapPin2Line className="mt-0.5 size-4 shrink-0 text-primary" />
            <span>{contact.address.join(", ")}</span>
          </li>
          <li class="flex items-center gap-2.5">
            <RiPhoneLine className="size-4 shrink-0 text-primary" />
            <span>{contact.phone}</span>
          </li>
          <li class="flex items-center gap-2.5">
            <RiMailLine className="size-4 shrink-0 text-primary" />
            <span>{contact.email}</span>
          </li>
          <li class="flex items-center gap-2.5">
            <RiGlobalLine className="size-4 shrink-0 text-primary" />
            <span>{contact.website}</span>
          </li>
        </ul>
      </div>
    </div>

    <Separator className="my-10 bg-white/10" />

    <div
      class="flex flex-col items-center justify-between gap-4 text-xs text-white/50 sm:flex-row"
    >
      <p>
        &copy; {new Date().getFullYear()} {site.name}. Alle rechten
        voorbehouden.
      </p>
      <div class="flex gap-6">
        <a href="/privacyverklaring" class="hover:text-white">
          Privacyverklaring
        </a>
        <a href="/algemene-voorwaarden" class="hover:text-white">
          Algemene voorwaarden
        </a>
      </div>
    </div>
  </div>
</footer>
